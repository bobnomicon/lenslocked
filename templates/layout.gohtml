{{ define "header" }}
<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
  </head>

  <body class="min-h-screen bg-gray-100">
    <header class="bg-gradient-to-r from-blue-800 to-indigo-800 text-white">
      <nav class="px-8 py-6 flex items-center space-x-12">
        <div class="text-4xl font-serif">Lenslocked</div>

        <div class="flex-grow">
          <a href="/" class="text-lg font-semibold hover:text-blue-100 pr-8">Home</a>
          <a href="/contact" class="text-lg font-semibold hover:text-blue-100 pr-8">Contact</a>
          <a href="/faq" class="text-lg font-semibold hover:text-blue-100 pr-8">FAQ</a>
        </div>

        <div class="space-x-4">
          {{ if currentUser }}
            <form action="/signout" method="post" class="inline pr-4">
              <div class="hidden">
                {{ csrfField }}
              </div>
              <button type="submit">Sign Out</button>
            </form>
          {{ else }}
            <a href="/signin" class="pr-4">Sign In</a>
            <a href="/signup" class="px-4 py-2 bg-blue-700 hover:bg-blue-600 rounded">Sign Up</a>
          {{ end }}
        </div>
      </nav>
    </header>

    <!-- Alerts -->
    {{ if errors }}
      <div class="alert-container pt-8 px-8">
        {{ range errors }}
          <div class="alert-message flex bg-red-100 rounded px-2 py-2 text-red-800 mb-2">
            <div class="flex-grow">{{ . }}</div>
            <a href="#" onclick="closeAlert(event)" aria-label="Close alert">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </a>
          </div>
        {{ end }}
      </div>
    {{ end }}
{{ end }}

<!-- Page content -->

{{ define "footer" }}
    <footer class="absolute bottom-0 w-full flex justify-center items-center bg-gradient-to-r from-blue-800 to-indigo-800 text-white h-14">
      <div>&copy; <span id="copyright">2025</span> Lenslocked</div>
    </footer>
  </body>

  <script>
    function closeAlert(event) {
      event.preventDefault();
      event.target.closest('.alert-message')?.remove();
      const alerts = document.querySelectorAll('.alert-message');
      if (alerts.length === 0) {
        // Close alert container if no more alert messages
        document.querySelector('.alert-container')?.remove();
      }
    }

    // Footer copyright
    const copyright = document.getElementById('copyright');
    copyright.innerText = new Date().getFullYear();
  </script>
</html>
{{ end }}
