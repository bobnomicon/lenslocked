{{ template "header" . }}

<div class="py-12 flex justify-center">
  <div class="w-1/3 px-8 py-8 bg-white rounded shadow">
    <h1 class="pt-4 pb-8 text-center text-3xl font-bold text-gray-900">Create a new gallery</h1>

    <form action="/galleries/new" method="POST">
        <div class="hidden">
          {{ csrfField }}
        </div>
        
        <div class="py-2">
          <label for="title" class="text-sm font-semibold text-gray-800">Gallery Title</label>
          <input id="title" name="title" type="text" placeholder="Gallery Title" required class="w-full px-3 py-2 border border-gray-300 placeholder-gray-500" value="{{ .Title }}" autofocus />
        </div>

        <div class="py-2">
          <button type="submit" class="w-full py-4 px-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded font-bold text-lg">Create</button>
        </div>
      </form>
    </div>
</div>

{{ template "footer" . }}
