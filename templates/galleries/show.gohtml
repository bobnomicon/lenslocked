{{ template "header" . }}

<div class="page">
  <h1 class="w-full py-8 text-4xl semibold tacking-light">{{ .Title }}</h1>

  <div class="columns-4 gap-4 space-y-4">
    {{ $counter := 1 }}
    {{ with . }}
      {{ range $index, $value := .Images }}
        <div class="h-min w-full">
          <a href="{{ $value }}" target="_blank">
              <img src="{{ $value }}" alt="{{ $.Title | title }} Image {{ $counter }}" class="w-full">
          </a>
        </div>
        {{ $counter = add $counter 1 }}
      {{ end }}
    {{ end }}
  </div>
</div>

{{ template "footer" . }}
