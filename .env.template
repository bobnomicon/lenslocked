# Server configs
SERVER_PORT=3000

# App configs
APP_URL=http://localhost:3000
APP_IMAGES_DIR=app/images
APP_IMAGES_EXT=.png,.jpg,.jpeg,.gif
APP_IMAGES_TYPE=image/png,image/jpeg,image/gif
APP_IMAGES_VOLUME=./app/images

# Caddy
CADDY_DATA_VOLUME=
